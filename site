body {
  background-color: #0d0d0d;
  font-family: 'Orbitron', sans-serif;
  color: #fff;
  text-align: center;
}

.product-card {
  display: inline-block;
  background: #1a1a1a;
  border: 2px solid #00f0ff;
  border-radius: 15px;
  margin: 20px;
  padding: 20px;
  width: 250px;
  transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:hover {
  transform: scale(1.05);
  box-shadow: 0 0 20px #00f0ff;
}

.product-card img {
  width: 100%;
  border-radius: 10px;
}

.jersey-name {
  font-size: 18px;
  color: #00f0ff;
}

.jersey-price {
  font-size: 16px;
  color: #fff;
}

.buy-btn {
  margin-top: 10px;
  padding: 10px 20px;
  background: #00f0ff;
  border: none;
  border-radius: 8px;
  color: #000;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.3s;
}

.buy-btn:hover {
  background: #00ffffa1;
}

